rule "FC-15 Detect Terraforming Pace Critical"
    when
        Insight($pid: playerId, type == InsightType.TEMPERATURE_STALLED)
        GameState(generation > 7, oxygenLevel < 8)
        PlayerState(id == $pid, $greeneries: greeneryCount, greeneryCount < 2)
        not Alert(playerId == $pid, type == AlertType.TERRAFORMING_PACE_CRITICAL)
    then
        insert(new Alert($pid, AlertType.TERRAFORMING_PACE_CRITICAL, Priority.URGENT,
            "Terraforming pace critical"));
        System.out.println("[FC-15] Alert inserted: Terraforming pace critical");
end

// FC LEVEL 3

rule "FC-17 Recommend Contest Mayor"
    when
        Alert($pid: playerId, type == AlertType.MAYOR_THREAT)
        $card: CardInHand(playerId == $pid, placesCity == true)
        not Recommendation(playerId == $pid, type == RecommendationType.PLAY_CARD,
                           subject == $card.getName())
    then
        insert(new Recommendation($pid, RecommendationType.PLAY_CARD,
            Priority.URGENT,
            $card.getName(),
            "Postavi grad odmah — protivnik je jednu akciju od osvajanja Mayor milestonea (5 VP, Rulebook str. 5)"));
        System.out.println("[FC-17] Recommendation umetnut: URGENT PLAY_CARD -> " + $card.getName());
end
