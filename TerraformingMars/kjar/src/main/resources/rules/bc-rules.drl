import java.util.List;

// Bazni slucaj — standalone query
query canClaimBaseCase(int $current, int $target)
    eval($current >= $target)
end

// ============================================================
// BC-1: canClaimMayor — Mayor milestone (3 grada)

// canClaimMayor(playerId, currentCities, 3)
// |__ currentCities >= 3 -> TRUE (bazni slucaj)
// |__ NE -> canClaimMayor(playerId, currentCities+1, 3)
//          |__ postoji city karta koju moze da odigra
//          |__ standardni projekat CITY (25 MC)
// ============================================================

// Rekurzivni slucaj 1 — preko karte
query canClaimMayorViaCard(long $playerId, int $current, int $target, int $remainingMc, UsedCards $usedCards)
    CardInHand(
        playerId == $playerId,
        placesCity == true,
        $cardId: id,
        $cost: cost
    )
    eval(!$usedCards.contains($cardId))
    eval($remainingMc >= $cost)
    canClaimMayor(
        $playerId,
        $current + 1,
        $target,
        $remainingMc - $cost,
        $usedCards.withAdded($cardId);
    )
end

// Rekurzivni slucaj 2 — standardni projekat
query canClaimMayorViaStandardProject(long $playerId, int $current, int $target, int $remainingMc, UsedCards $usedCards)
    eval($remainingMc >= 25)
    canClaimMayorJustStandard(
        $playerId,
        $current + 1,
        $target,
        $remainingMc - 25,
        $usedCards;
    )
end

query canClaimMayor(long $playerId, int $current, int $target, int $remainingMc, UsedCards $usedCards)

    canClaimBaseCase($current, $target;)
    or
    ( eval($current < $target) and canClaimMayorViaCard($playerId, $current, $target, $remainingMc, $usedCards;) )
    or
    ( eval($current < $target) and canClaimMayorViaStandardProject($playerId, $current, $target, $remainingMc, $usedCards;) )

end

query canClaimMayorJustStandard(long $playerId, int $current, int $target, int $remainingMc, UsedCards $usedCards)

    canClaimBaseCase($current, $target;)
    or
    ( eval($current < $target) and canClaimMayorViaStandardProject($playerId, $current, $target, $remainingMc, $usedCards;) )

end

rule "BC-1 Mayor Reachability"
    when
        $player: PlayerState(currentPlayer == true, $pid: id, $mc: megacredits)
        Milestone(type == MilestoneType.MAYOR, claimed == false)

        $claimedCount : Number() from accumulate(
            Milestone(claimed == true),
            count(1)
        )
        eval($claimedCount.intValue() < 3)

        $currentCities: Number() from accumulate(
            TilePlaced(playerId == $pid, tileType == TileType.CITY),
            count(1)
        )
        $initialUsedCards : UsedCards() from new UsedCards()
        canClaimMayor($pid, $currentCities.intValue(), 3, $mc, $initialUsedCards;)
        not MilestoneReport(playerId == $pid, milestoneType == MilestoneType.MAYOR)
    then
        boolean reachableNow = $currentCities.intValue() >= 3;
        String desc = reachableNow
            ? "Mayor milestone reachable now — claim it before the opponent!"
            : "Mayor milestone reachable with card in hand";

        insert(new MilestoneReport($pid, MilestoneType.MAYOR, reachableNow, desc));
        insert(new Recommendation($pid, RecommendationType.CLAIM_MILESTONE,
        Priority.HIGH, "MAYOR", desc));
        System.out.println("[BC-1] Mayor recursive check evaluated true.");
end

// ============================================================
// BC-2: canClaimBuilder — Builder milestone (8 building tagova)
//
// canClaimBuilder(playerId, currentTags, 8)
// |__ currentTags >= 8 -> TRUE (bazni slucaj)
// |__ NE -> canClaimBuilder(playerId, currentTags+1, 8)
//          |__ postoji building karta koju moze da odigra
//
// Napomena: Builder nema standardni projekat —
// jedini nacin je odigravanjem building karte.
// ============================================================

// Rekurzivni slucaj — preko karte
query canClaimBuilderViaCard(long $playerId, int $current, int $target, int $remainingMc, UsedCards $usedCards)
    CardInHand(
        playerId == $playerId,
        $cardId: id,
        $cost: cost,
        tags contains CardTag.BUILDING
    )
    eval(!$usedCards.contains($cardId))
    eval($remainingMc >= $cost)
    canClaimBuilder(
        $playerId,
        $current + 1,
        $target,
        $remainingMc - $cost,
        $usedCards.withAdded($cardId);
    )
end

query canClaimBuilder(long $playerId, int $current, int $target, int $remainingMc, UsedCards $usedCards)

    canClaimBaseCase($current, $target;)
    or
    ( eval($current < $target) and canClaimBuilderViaCard($playerId, $current, $target, $remainingMc, $usedCards;) )

end

rule "BC-2 Builder Reachability"
    when
        $player: PlayerState(currentPlayer == true, $pid: id, $mc: megacredits, $currentCount: buildingTagCount)
        Milestone(type == MilestoneType.BUILDER, claimed == false)

        $claimedCount : Number() from accumulate(
            Milestone(claimed == true),
            count(1)
        )
        eval($claimedCount.intValue() < 3)

        $initialUsedCards : UsedCards() from new UsedCards()
        canClaimBuilder($pid, $currentCount, 8, $mc, $initialUsedCards;)
        not MilestoneReport(playerId == $pid, milestoneType == MilestoneType.BUILDER)
    then
        boolean reachableNow = $currentCount >= 8;
        String desc = reachableNow
            ? "Builder milestone reachable now — claim it before the opponent!"
            : "Builder milestone reachable with card in hand";

        insert(new MilestoneReport($pid, MilestoneType.BUILDER, reachableNow, desc));
        insert(new Recommendation($pid, RecommendationType.CLAIM_MILESTONE,
            Priority.HIGH, "BUILDER", desc));
        System.out.println("[BC-2] Builder reachable (now=" + reachableNow +
            ", buildingTags=" + $currentCount + ")");
end

// ============================================================
// BC-3: canClaimGardener — Gardener milestone (3 zelenila)
//
// canClaimGardener(playerId, currentGreens, 3)
// |__ currentGreens >= 3 -> TRUE (bazni slucaj)
// |__ NE -> canClaimGardener(playerId, currentGreens+1, 3)
//          |__ postoji greenery karta (dovoljno biljaka/MC)
//          |__ standardni projekat GREENERY (8 biljaka)
// ============================================================

// Rekurzivni slucaj 1 — preko karte
query canClaimGardenerViaCard(long $playerId, int $current, int $target, int $remainingMc, int $remainingPlants, UsedCards $usedCards)
    CardInHand(
        playerId == $playerId,
        placesGreenery == true,
        $cardId: id,
        $cost: cost
    )
    eval(!$usedCards.contains($cardId))
    eval($remainingMc >= $cost)
    canClaimGardener(
        $playerId,
        $current + 1,
        $target,
        $remainingMc - $cost,
        $remainingPlants,
        $usedCards.withAdded($cardId);
    )
end

// Rekurzivni slucaj 2 — standardni projekat
query canClaimGardenerViaStandardProject(long $playerId, int $current, int $target, int $remainingMc, int $remainingPlants, UsedCards $usedCards)
    eval($remainingPlants >= 8)
    canClaimGardenerJustStandard(
        $playerId,
        $current + 1,
        $target,
        $remainingMc,
        $remainingPlants - 8,
        $usedCards;
    )
end

query canClaimGardener(long $playerId, int $current, int $target, int $remainingMc, int $remainingPlants, UsedCards $usedCards)

    canClaimBaseCase($current, $target;)
    or
    ( eval($current < $target) and canClaimGardenerViaCard($playerId, $current, $target, $remainingMc, $remainingPlants, $usedCards;) )
    or
    ( eval($current < $target) and canClaimGardenerViaStandardProject($playerId, $current, $target, $remainingMc, $remainingPlants, $usedCards;) )

end

query canClaimGardenerJustStandard(long $playerId, int $current, int $target, int $remainingMc, int $remainingPlants, UsedCards $usedCards)

    canClaimBaseCase($current, $target;)
    or
    ( eval($current < $target) and canClaimGardenerViaStandardProject($playerId, $current, $target, $remainingMc, $remainingPlants, $usedCards;) )

end

rule "BC-3 Gardener Reachability"
    when
        $player: PlayerState(currentPlayer == true, $pid: id, $mc: megacredits, $plants: plants)
        Milestone(type == MilestoneType.GARDENER, claimed == false)

        $claimedCount : Number() from accumulate(
            Milestone(claimed == true),
            count(1)
        )
        eval($claimedCount.intValue() < 3)

        $currentGreens: Number() from accumulate(
            TilePlaced(playerId == $pid, tileType == TileType.GREENERY),
            count(1)
        )
        $initialUsedCards : UsedCards() from new UsedCards()
        canClaimGardener($pid, $currentGreens.intValue(), 3, $mc, $plants, $initialUsedCards;)
        not MilestoneReport(playerId == $pid, milestoneType == MilestoneType.GARDENER)
    then
        boolean reachableNow = $currentGreens.intValue() >= 3;
        String desc = reachableNow
            ? "Gardener milestone reachable now — claim it before the opponent!"
            : "Gardener milestone reachable with card in hand or standard project";

        insert(new MilestoneReport($pid, MilestoneType.GARDENER, reachableNow, desc));
        insert(new Recommendation($pid, RecommendationType.CLAIM_MILESTONE,
            Priority.HIGH, "GARDENER", desc));
        System.out.println("[BC-3] Gardener reachable (now=" + reachableNow +
            ", greens=" + $currentGreens.intValue() + ")");
end

// ============================================================
// BC-4: canWinScientist — Scientist nagrada (najvise SCIENCE tagova)
//
// canWinScientist(playerId, myCount, opponentMax)
// |__ myCount > opponentMax -> TRUE (bazni slucaj)
// |__ NE -> canWinScientist(playerId, myCount+1, opponentMax)
//          |__ postoji science karta koju moze da odigra
// ============================================================

// Bazni slucaj
query canWinBase(int $myCount, int $opponentMax)
    eval($myCount > $opponentMax)
end

// Rekurzivni slucaj — postoji science karta u ruci koju igrac moze priustiti
query canWinScientistViaCard(long $playerId, int $myCount, int $opponentMax, int $remainingMc, UsedCards $usedCards)
    CardInHand(
        playerId == $playerId,
        $cardId: id,
        $cost: cost,
        tags contains CardTag.SCIENCE
    )
    eval(!$usedCards.contains($cardId))
    eval($remainingMc >= $cost)
    canWinScientist(
        $playerId,
        $myCount + 1,
        $opponentMax,
        $remainingMc - $cost,
        $usedCards.withAdded($cardId);
    )
end

query canWinScientist(long $playerId, int $myCount, int $opponentMax, int $remainingMc, UsedCards $usedCards)

    canWinBase($myCount, $opponentMax;)
    or
    ( eval($myCount <= $opponentMax) and canWinScientistViaCard($playerId, $myCount, $opponentMax, $remainingMc, $usedCards;) )

end

rule "BC-4 Scientist Award Winnable"
    when
        $player: PlayerState(currentPlayer == true, $pid: id, $mc: megacredits)
        Award(type == AwardType.SCIENTIST, funded == false)
        $myCount: Number() from accumulate(
            PlayedCard(playerId == $pid, tags contains CardTag.SCIENCE),
            count(1)
        )
        $playedCards : List() from collect(
            PlayedCard()
        )
        $oppMax : Integer() from QueryUtils.getMaxOpponentScienceTags($pid, $playedCards)
        $fundedCount : Number() from accumulate(
            Award(funded == true),
            count(1)
        )
        eval($fundedCount.intValue() < 3)

        eval(
            ($fundedCount.intValue() == 0 && $mc >= 8)
            ||
            ($fundedCount.intValue() == 1 && $mc >= 14)
            ||
            ($fundedCount.intValue() == 2 && $mc >= 20)
        )
        $initialUsedCards: UsedCards() from new UsedCards()
        canWinScientist($pid, $myCount.intValue(), $oppMax.intValue(), $mc, $initialUsedCards;)
        not Recommendation(playerId == $pid,
                           type == RecommendationType.FUND_AWARD,
                           subject == "SCIENTIST")
    then
        insert(new Recommendation($pid, RecommendationType.FUND_AWARD,
            Priority.HIGH, "SCIENTIST",
            "You lead or can lead in science tags — finance the Scientist award"));
        System.out.println("[BC-4] Recommendation: HIGH FUND_AWARD SCIENTIST" +
            " (myCount=" + $myCount +
            ", oppMax=" + $oppMax.intValue() + ")");
end

// ============================================================
// BC-5: canWinBanker — Banker nagrada (najvisa MC produkcija)
//
// canWinBanker(playerId, myProduction, opponentMax)
// |__ myProduction > opponentMax -> TRUE (bazni slucaj)
// |__ NE -> canWinBanker(playerId, myProduction+increase, opponentMax)
//          |__ postoji production karta
//              sa konkretnim iznosom povecanja
// ============================================================

query canWinBankerViaCard(long $playerId, int $myProd, int $opponentMax, int $remainingMc, UsedCards $usedCards)
    CardInHand(
        playerId == $playerId,
        $cardId: id,
        $cost: cost,
        $inc: mcProductionIncrease
    )
    eval($inc > 0)
    eval(!$usedCards.contains($cardId))
    eval($remainingMc >= $cost)
    canWinBanker(
        $playerId,
        $myProd + $inc,
        $opponentMax,
        $remainingMc - $cost,
        $usedCards.withAdded($cardId);
    )
end

query canWinBanker(long $playerId, int $myProd, int $opponentMax, int $remainingMc, UsedCards $usedCards)

    canWinBase($myProd, $opponentMax;)
    or
    ( eval($myProd <= $opponentMax) and canWinBankerViaCard($playerId, $myProd, $opponentMax, $remainingMc, $usedCards;) )

end

rule "BC-5 Banker Award Winnable"
    when
        $player: PlayerState(currentPlayer == true, $pid: id, $mc: megacredits, $myProd: mcProduction)
        Award(type == AwardType.BANKER, funded == false)

        $oppMax: Number() from accumulate(
            PlayerState(id != $pid, $op: mcProduction),
            max($op)
        )

        $fundedCount : Number() from accumulate(
            Award(funded == true),
            count(1)
        )

        eval($fundedCount.intValue() < 3)
        eval(
            ($fundedCount.intValue() == 0 && $mc >= 8) ||
            ($fundedCount.intValue() == 1 && $mc >= 14) ||
            ($fundedCount.intValue() == 2 && $mc >= 20)
        )

        $initialUsed : UsedCards() from new UsedCards()
        canWinBanker($pid, $myProd, $oppMax.intValue(), $mc, $initialUsed;)

        not Recommendation(playerId == $pid, type == RecommendationType.FUND_AWARD, subject == "BANKER")
    then
        insert(new Recommendation($pid, RecommendationType.FUND_AWARD,
            Priority.HIGH, "BANKER",
            "You lead or can lead in MC production — finance the Banker award"));
        System.out.println("[BC-5] Recommendation: HIGH FUND_AWARD BANKER (myProd=" + $myProd +
            ", oppMax=" + $oppMax.intValue() + ")");
end