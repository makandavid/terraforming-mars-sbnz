template header
cardName
requiredTag
threshold
priority
effectText

package rules;

import com.tm.facts.PlayerState;
import com.tm.facts.PlayedCard;
import com.tm.facts.CardInHand;
import com.tm.enums.CardTag;
import com.tm.enums.RecommendationType;
import com.tm.enums.Priority;
import com.tm.output.Recommendation;

template "CardSynergy"

// Auto-generated rule for card @{cardName}
// Synergy: @{threshold}+ @{requiredTag} tags
rule "Template-Synergy-@{cardName}-@{requiredTag}"
    when
        $player: PlayerState(currentPlayer == true, $pid: id)

        CardInHand(playerId == $pid, name == "@{cardName}")

        $count: Number(intValue >= @{threshold}) from accumulate(
            PlayedCard(
                playerId == $pid,
                tags contains CardTag.@{requiredTag}
            ),
            count(1)
        )

        not Recommendation(
            playerId == $pid,
            type == RecommendationType.ACTION_ENABLED_BY_CARD_CONDITION,
            subject == "@{cardName}"
        )
    then
        insert(new Recommendation(
            $pid,
            RecommendationType.ACTION_ENABLED_BY_CARD_CONDITION,
            Priority.@{priority},
            "@{cardName}",
            "@{effectText} (currently you have " + $count.intValue() + " @{requiredTag} tags)"
        ));
        System.out.println("[TEMPLATE] Synergy: @{cardName} (@{requiredTag} >= @{threshold}, count=" + $count.intValue() + ")");
end

end template